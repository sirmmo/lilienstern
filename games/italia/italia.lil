# Italia's economy: what a place pays and gives follows its people (1871 census, in thousands),
# so Napoli or Milano are worth more than an Alpine valley. The decisions and the troops are
# Marches' (../marches/realms.lil, ../marches/eras/).

event taxes
    scope place
    for realm
    do global Funds add map Population $tax_per_thousand
end

event rich_taxes
    scope place
    for realm
    if map Wealth greater 60
    do global Funds add map Population $rich_tax_per_thousand
end

event muster
    scope place
    for realm
    do global Recruits add map Population $recruits_per_thousand
end

event learning
    scope place
    for realm
    do global Learning add map Population $learning_per_thousand
end

event studia                     # the old universities: Bologna, Padova, Napoli, Siena...
    scope place
    for realm
    if map University greater 0
    do global Learning add map University $learning_per_university
end

event more_learning              # the Universities tech doubles it
    scope place
    for realm
    if tech universities
    do global Learning add map Population $learning_per_thousand
end
